# SQLite is the operational local fallback.
DATABASE_URL=sqlite:///./impactlink.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg://impactlink:YOUR_PASSWORD@localhost:5432/impactlink
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3017,http://127.0.0.1:3017
# No AI credentials are needed. LLM extraction is not implemented.
